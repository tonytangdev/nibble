{
  "name": "nibble",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "ui:dev": "vite ui",
    "ui:build": "vite build ui",
    "site:dev": "vite site",
    "site:build": "vite build site",
    "fmt": "cargo fmt --all && prettier --write .",
    "fmt:check": "cargo fmt --all --check && prettier --check .",
    "typecheck": "pnpm app:typecheck && pnpm site:typecheck",
    "lint": "pnpm app:lint && pnpm site:lint",
    "app:fmt:check": "cargo fmt --all --check && prettier --check ui crates",
    "app:typecheck": "tsc",
    "app:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings && eslint ui eslint.config.js",
    "app:test": "cargo test --workspace",
    "app:deny": "cargo deny check",
    "app:check": "pnpm app:fmt:check && pnpm app:typecheck && pnpm app:lint && pnpm app:test && pnpm app:deny",
    "site:fmt:check": "prettier --check site",
    "site:typecheck": "tsc -p site",
    "site:lint": "eslint site",
    "site:check": "pnpm site:fmt:check && pnpm site:typecheck && pnpm site:lint && pnpm site:build",
    "check": "prettier --check . && pnpm app:check && pnpm site:check",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm fmt:check && pnpm typecheck && pnpm lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "type": "module"
}
