{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nibble",
  "identifier": "dev.tonytang.nibble",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm ui:dev",
      "cwd": "../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "pnpm ui:build",
      "cwd": "../.."
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Nibble",
        "width": 340,
        "height": 480,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNEU3QjQ4QTg2MDUzRTgKUldUb1UyQ29TSHRPMGt0Q2VHTml2cEVWTlg5WTZRdUl1WU5GaFRONUxpT2xmSVdiSk84WGNySEoK",
      "endpoints": ["https://github.com/tonytangdev/nibble/releases/latest/download/latest.json"]
    }
  }
}
